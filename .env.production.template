# ============================================================================
# Deep-Doc-Analysis Production Environment Configuration
# ============================================================================
#
# IMPORTANT SECURITY NOTES:
# 1. This is a TEMPLATE - copy to .env.production and fill in real values
# 2. NEVER commit .env.production to Git
# 3. Rotate all API keys before production deployment
# 4. Use Hetzner Cloud environment variables or secrets manager for sensitive data
#
# ============================================================================

# ============================================================================
# LLM PROVIDER CONFIGURATION
# ============================================================================

# LLM Provider: 'claude' or 'ollama'
LLM_PROVIDER=claude

# Anthropic Claude API Configuration
# Get your API key from: https://console.anthropic.com/settings/keys
# SECURITY: Rotate this key if it was previously exposed in development
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_WITH_PRODUCTION_KEY

# Claude Model
CLAUDE_MODEL=claude-sonnet-4-20250514

# Ollama Configuration (if using local LLM)
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=qwen2.5:3b

# ============================================================================
# BACKEND API CONFIGURATION
# ============================================================================

# API Version
API_V1_STR=/api/v1

# CORS Configuration
# CRITICAL: Update with your production domain(s)
BACKEND_CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Production domain (used for redirect URIs)
FRONTEND_URL=https://yourdomain.com

# ============================================================================
# FILE UPLOAD CONFIGURATION
# ============================================================================

# Upload directory (inside container)
UPLOAD_DIR=/app/uploads

# Maximum file size in bytes (50MB default)
MAX_FILE_SIZE=52428800

# Allowed file extensions
ALLOWED_EXTENSIONS=.xlsx,.xls,.xlsm

# File retention policy (days) - Auto-cleanup after this period
# Set to 0 to disable auto-cleanup
FILE_RETENTION_DAYS=30

# ============================================================================
# ANALYTICS DATABASE CONFIGURATION
# ============================================================================

# Enable analytics tracking
ANALYTICS_ENABLED=true

# SQLite database path
ANALYTICS_DB_URL=sqlite+aiosqlite:////app/analytics.db

# Data retention (days) - Events older than this are deleted
ANALYTICS_RETENTION_DAYS=90

# ============================================================================
# STYTCH AUTHENTICATION CONFIGURATION
# ============================================================================
#
# IMPORTANT: Create a NEW production project in Stytch dashboard
# DO NOT use test environment credentials in production!
# Get credentials from: https://stytch.com/dashboard
#

# Stytch Environment (MUST be 'live' for production)
STYTCH_ENV=live

# Stytch Project ID (starts with 'project-live-')
STYTCH_PROJECT_ID=project-live-REPLACE_WITH_YOUR_PROJECT_ID

# Stytch Secret Key (backend only - starts with 'secret-live-')
STYTCH_SECRET=secret-live-REPLACE_WITH_YOUR_SECRET

# Stytch Public Token (frontend - starts with 'public-token-live-')
# This will be baked into the frontend build
VITE_STYTCH_PUBLIC_TOKEN=public-token-live-REPLACE_WITH_YOUR_PUBLIC_TOKEN

# ============================================================================
# METABASE CONFIGURATION
# ============================================================================

# Enable Metabase analytics dashboard
METABASE_ENABLED=true

# Metabase internal URL (Docker network)
METABASE_URL=http://metabase:3000

# Metabase is bound to localhost:3001 for security
# Access via SSH tunnel: ssh -L 3001:localhost:3001 user@server

# ============================================================================
# FRONTEND BUILD CONFIGURATION
# ============================================================================

# Backend API URL (baked into frontend build)
# MUST match your production domain + /api/v1
VITE_API_URL=https://yourdomain.com/api/v1

# ============================================================================
# SECURITY & RATE LIMITING
# ============================================================================

# Enable rate limiting
RATE_LIMIT_ENABLED=true

# Chat endpoint limit (requests per minute)
CHAT_RATE_LIMIT=10

# Upload endpoint limit (requests per minute)
UPLOAD_RATE_LIMIT=5

# Session cookie settings
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file location
LOG_FILE=/app/logs/app.log

# Enable JSON structured logging
JSON_LOGS=true

# ============================================================================
# BACKUP CONFIGURATION
# ============================================================================

# Backup directory (on host)
BACKUP_DIR=/opt/deepdoc/backups

# Backup retention (days)
BACKUP_RETENTION_DAYS=30

# Hetzner Storage Box (optional - for off-site backups)
# STORAGE_BOX_HOST=u123456.your-storagebox.de
# STORAGE_BOX_USER=u123456
# STORAGE_BOX_PATH=/backups/deepdoc

# ============================================================================
# MONITORING & ALERTING
# ============================================================================

# Enable health check endpoint
HEALTH_CHECK_ENABLED=true

# Alert email (for backup/monitoring notifications)
ALERT_EMAIL=admin@yourdomain.com

# Sentry DSN (optional - for error tracking)
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
# SENTRY_ENVIRONMENT=production

# ============================================================================
# PRODUCTION OPTIMIZATIONS
# ============================================================================

# Number of Uvicorn workers (1 per CPU core recommended)
WORKERS=2

# Uvicorn worker timeout (seconds)
TIMEOUT=60

# Enable production mode optimizations
PRODUCTION=true

# Disable debug mode
DEBUG=false

# ============================================================================
# DOCKER CONFIGURATION
# ============================================================================

# Restart policy (for docker-compose)
RESTART_POLICY=always

# ============================================================================
# NOTES FOR DEPLOYMENT
# ============================================================================
#
# 1. After creating .env.production from this template:
#    - Replace ALL placeholder values (REPLACE_WITH_*)
#    - Ensure STYTCH_ENV=live
#    - Update BACKEND_CORS_ORIGINS with your domain
#    - Update FRONTEND_URL with your domain
#    - Update VITE_API_URL with your domain
#
# 2. Secure file transfer to server:
#    scp .env.production user@your-server:/opt/deepdoc/.env
#
# 3. Set correct permissions on server:
#    chmod 600 /opt/deepdoc/.env
#    chown root:root /opt/deepdoc/.env
#
# 4. Build frontend with production env vars:
#    docker-compose -f docker-compose.prod.yml build frontend
#
# 5. Start all services:
#    docker-compose -f docker-compose.prod.yml up -d
#
# ============================================================================
