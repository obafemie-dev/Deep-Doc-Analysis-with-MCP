# API Settings
API_V1_STR=/api/v1
PROJECT_NAME=Deep Doc Analysis with MCP

# CORS Origins - Update with your frontend URL
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "https://your-frontend.onrender.com"]

# File Upload Settings
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800  # 50MB in bytes
ALLOWED_EXTENSIONS=[".xlsx", ".xls", ".xlsm"]

# LLM Provider Selection
LLM_PROVIDER=claude  # "ollama" or "claude"

# Claude API Settings (primary provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-20250514

# Ollama Settings (legacy - only used if LLM_PROVIDER="ollama")
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct

# MCP Server Settings
MCP_SERVER_NAME=Excel Analysis Server
