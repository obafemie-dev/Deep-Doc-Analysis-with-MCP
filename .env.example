# LLM Provider Configuration
LLM_PROVIDER=claude  # Options: "claude" or "ollama"

# API Settings
API_V1_STR=/api/v1
PROJECT_NAME=Deep Doc Analysis with MCP

# CORS Settings (comma-separated list of allowed origins)
# For Render deployment, add your frontend URL: https://your-frontend.onrender.com
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# File Upload Settings
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=52428800
ALLOWED_EXTENSIONS=.xlsx,.xls,.xlsm

# Ollama Settings (if using Ollama)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b

# Claude Settings (if using Claude)
ANTHROPIC_API_KEY=your-api-key-here
CLAUDE_MODEL=claude-sonnet-4-20250514

# MCP Server Settings
MCP_SERVER_NAME=Excel Analysis Server

# Analytics Settings
ANALYTICS_ENABLED=true
ANALYTICS_DB_URL=sqlite+aiosqlite:///./analytics.db
ANALYTICS_BATCH_SIZE=100
ANALYTICS_RETENTION_DAYS=90

# Metabase Proxy Settings
METABASE_ENABLED=true
METABASE_URL=http://metabase:3000
METABASE_TIMEOUT=60

# Stytch Authentication Settings (get from stytch.com/dashboard)
STYTCH_PROJECT_ID=project-test-your-project-id
STYTCH_SECRET=secret-test-your-secret-key
STYTCH_ENV=test
FRONTEND_URL=http://localhost:3000

# Application Settings
PYTHONUNBUFFERED=1

# Frontend Settings
VITE_API_URL=http://localhost:8000/api/v1
VITE_STYTCH_PUBLIC_TOKEN=public-token-test-your-public-token
